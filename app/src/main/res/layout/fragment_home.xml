<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="28dp" android:paddingTop="18dp" android:paddingEnd="28dp" android:paddingBottom="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_user" android:alpha="0.7" />
            <TextView android:id="@+id/tvUser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:textColor="@color/text_dim" android:textSize="17sp" />
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="32dp" android:src="@drawable/ic_calendar" android:alpha="0.7" />
            <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:textColor="@color/text_dim" android:textSize="17sp" />
        </LinearLayout>

        <TextView android:id="@+id/tvBannerTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="Destaques do dia" android:textColor="@color/accent" android:textSize="20sp" android:textStyle="bold" />
        <FrameLayout android:id="@+id/bannerBox" android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="8dp"
            android:background="@drawable/sel_poster" android:focusable="true" android:clickable="true" android:padding="3dp">
            <ImageView android:id="@+id/banner" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
            <TextView android:id="@+id/bannerDots" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:layout_margin="8dp" android:textColor="@color/text" android:textSize="14sp" />
        </FrameLayout>

        <TextView android:id="@+id/tvContinue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="Continuar assistindo" android:textSize="18sp" android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvContinue" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:clipToPadding="false" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="Adicionados recentemente" android:textSize="18sp" android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRecent" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:clipToPadding="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
