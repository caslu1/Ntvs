<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:singleLine="true" android:textColor="@color/text_dim" android:textSize="16sp" />
    <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/text_dim" android:textSize="13sp" />
</LinearLayout>
