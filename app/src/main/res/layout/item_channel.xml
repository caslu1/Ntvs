<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/sel_item"
    android:focusable="true" android:clickable="true" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="10dp" android:paddingTop="9dp" android:paddingEnd="8dp" android:paddingBottom="9dp">
    <TextView android:id="@+id/num" android:layout_width="34dp" android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="13sp" />
    <ImageView android:id="@+id/logo" android:layout_width="42dp" android:layout_height="30dp" android:layout_marginEnd="10dp" android:scaleType="fitCenter" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:singleLine="true" android:textColor="@color/text" android:textSize="16sp" />
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:singleLine="true" android:textColor="@color/text_dim" android:textSize="12sp" />
    </LinearLayout>
    <ImageView android:id="@+id/fav" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_star" android:visibility="gone" />
</LinearLayout>
