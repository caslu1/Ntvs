<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <LinearLayout android:layout_width="190dp" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp">
            <TextView android:id="@+id/btnSearch" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="6dp"
                android:background="@drawable/sel_pill" android:drawableStart="@drawable/ic_search" android:drawablePadding="8dp"
                android:focusable="true" android:clickable="true" android:gravity="center_vertical" android:paddingStart="14dp"
                android:text="Buscar" android:textSize="16sp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCats" android:layout_width="match_parent" android:layout_height="match_parent" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="6dp">
                <TextView android:id="@+id/tabMovies" style="@style/Tab" android:text="Filmes" />
                <TextView android:id="@+id/tabSeries" style="@style/Tab" android:text="Séries" />
                <TextView android:id="@+id/tabFavs" style="@style/Tab" android:text="Favoritos" />
            </LinearLayout>
            <EditText android:id="@+id/etSearch" style="@style/LoginInput" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:hint="Digite o nome do filme ou série..." android:imeOptions="actionSearch" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvGrid" android:layout_width="match_parent" android:layout_height="match_parent"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:clipToPadding="false" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" />
    <TextView android:id="@+id/tvEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
        android:textColor="@color/text_dim" android:visibility="gone" />
</FrameLayout>
