<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/sel_poster"
    android:focusable="true" android:clickable="true" android:orientation="vertical" android:padding="5dp">
    <ImageView android:id="@+id/poster" android:layout_width="match_parent" android:layout_height="160dp" android:scaleType="centerCrop" />
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:ellipsize="end" android:singleLine="true" android:textColor="@color/text" android:textSize="13sp" />
</LinearLayout>
