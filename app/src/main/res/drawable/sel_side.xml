<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><gradient android:angle="0" android:startColor="@color/accent_dark" android:endColor="@color/accent" /></shape></item>
    <item android:state_selected="true"><shape><gradient android:angle="0" android:startColor="@color/accent_dark" android:endColor="@color/accent" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/accent" /></shape></item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
